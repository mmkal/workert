{
  "name": "workert",
  "version": "0.0.0",
  "description": "POC of TypeScript compiler running in a Cloudflare Worker",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "test": "bun test",
    "dev": "vite dev",
    "build": "bun build.ts && vite build",
    "preview": "bun run build && vite preview",
    "deploy": "bun run build && wrangler deploy",
    ".build": "bun run build.ts",
    ".dev": "bun run build && bun run alchemy dev",
    ".deploy": "bun run build && bun run alchemy deploy",
    "destroy": "bun run alchemy destroy"
  },
  "keywords": [
    "cloudflare",
    "worker",
    "typescript",
    "compiler"
  ],
  "author": "mmakl",
  "license": "Apache-2.0",
  "dependencies": {
    "alchemy": "^0.81.1",
    "tswasm": "0.1.0-alpha.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.18.0",
    "@types/bun": "1.3.4",
    "miniflare": "4.20251213.0",
    "vite": "7.3.0"
  }
}
